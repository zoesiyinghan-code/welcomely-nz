<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Forgot Password</title>

    <link rel="stylesheet" href="/public/css/styles.css">
    <%- include('partials/header1.ejs') %>

    <style>
        .auth-card {
            max-width: 420px;
            margin: 80px auto;
            padding: 30px;
            background: rgba(255,255,255,0.85);
            border-radius: 14px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
            backdrop-filter: blur(10px);
        }

        .auth-title {
            font-size: 1.6rem;
            font-weight: 600;
            margin-bottom: 10px;
            text-align: center;
        }

        .auth-subtext {
            font-size: 0.95rem;
            text-align: center;
            margin-bottom: 20px;
            color: #555;
        }

        .error-message {
            color: #b00020;
            text-align: center;
            margin-bottom: 15px;
            font-size: 0.9rem;
        }

        form {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        input {
            padding: 10px;
            border-radius: 8px;
            border: 1px solid #ccc;
            font-size: 0.95rem;
        }

        button {
            padding: 10px;
            border-radius: 8px;
            border: none;
            background: #2c6bed;
            color: #fff;
            font-size: 1rem;
            cursor: pointer;
        }

        button:hover {
            background: #1f55c0;
        }

        .small-links {
            margin-top: 18px;
            text-align: center;
        }

        .small-links a {
            font-size: 0.9rem;
            color: #2c6bed;
            text-decoration: none;
        }
    </style>
</head>

<body>

    <!-- ⭐ UNIVERSAL NAVBAR -->
    <%- include('partials/navbar.ejs') %>
     <!-- ⭐ UNIVERSAL Background -->
    <%- include('partials/globalBackground') %>

<div class="auth-card">
    <div class="auth-title">Forgot Password</div>

    <% if (!step || step === 'identify') { %>
        <p class="auth-subtext">
            Enter your username to reset your password.
        </p>

       <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>

            <div class="error-message"><%= errorMessage %></div>
        <% } %>

        <form action="/forgotPassword" method="post">
            <input
                type="text"
                name="username"
                placeholder="Username"
                required
            >

            <input
                type="email"
                name="email"
                placeholder="Email address"
                required
            >

            <button type="submit">Continue</button>
        </form>


    <% } else if (step === 'reset') { %>
        <p class="auth-subtext">
            Set a new password for <strong><%= username %></strong>
        </p>

        <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>

            <div class="error-message"><%= errorMessage %></div>
        <% } %>

        <form action="/resetPassword" method="post">
            <input type="hidden" name="token" value="<%= token %>">
            

            <input
                type="password"
                name="newPassword"
                placeholder="New password (min 8 characters)"
                minlength="8"
                required
            >

            <input
                type="password"
                name="confirmPassword"
                placeholder="Confirm new password"
                minlength="8"
                required
            >

            <button type="submit">Update Password</button>
        </form>
    <% } %>

    <div class="small-links">
        <a href="/login">Back to Login</a>
    </div>
</div>

</body>
</html>

