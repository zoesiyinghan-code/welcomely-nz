<!DOCTYPE html>
<html>
<head>
    <%- include('partials/header1.ejs') %>
    <link rel="stylesheet" href="/public/css/styles.css">

    <style>
        .welcome-card {
            max-width: 800px;
            margin: 50px auto;
            padding: 30px;
            background: white;
            border-radius: 14px;
            border: 1px solid #E2E8F0;
            box-shadow: 0 8px 25px rgba(0,0,0,0.06);
        }

        .submission-card {
            margin-top: 20px;
            padding: 20px;
            border-radius: 12px;
            border: 1px solid #E5E7EB;
            background: #F9FAFB;
        }

        .submission-actions {
            margin-top: 10px;
        }

        .status {
            font-weight: bold;
        }

        .cta-button {
            display: inline-block;
            margin-top: 25px;
            padding: 10px 16px;
            background: #2563EB;
            color: white;
            text-decoration: none;
            border-radius: 8px;
        }

        .flash-success {
            margin: 20px 0;
            padding: 12px 16px;
            border-radius: 8px;
            background: #ECFDF5;
            border: 1px solid #34D399;
            color: #065F46;
            font-weight: 500;
        }

        .flash-error {
            margin: 20px 0;
            padding: 12px 16px;
            border-radius: 8px;
            background: #FEF2F2;
            border: 1px solid #FCA5A5;
            color: #991B1B;
            font-weight: 500;
        }
    </style>
</head>

<body>
    <%- include('partials/navbar.ejs') %>
    <%- include('partials/globalBackground') %>

    <% if (session.role === 'lia') { %>
    <a href="/liaSubmit" class="floating-cta">
        + New Submission
    </a>
    <% } %>
    <% if (session.role === 'migrant') { %>
        <a href="/migrantQueries" class="floating-cta">
            + Ask a Question
        </a>
    <% } %>
    <div class="welcome-card">
        <h2>Welcome, <%= session.username %>!</h2>

        <% if (successMessage) { %>
            <div class="flash-success"><%= successMessage %></div>
        <% } %>

        <% if (errorMessage) { %>
            <div class="flash-error"><%= errorMessage %></div>
        <% } %>

        <!-- ========================= -->
        <!-- ADMIN DASHBOARD -->
        <!-- ========================= -->
        <% if (session.role === 'admin') { %>
            <p>
                You are logged in as an <strong>Administrator</strong>.
                You have access to review LIA submissions and manage platform content.
            </p>

            <a href="/adminReview" class="cta-button">Review LIA Submissions</a>
            <a href="/admin/migrantqueries" class="cta-button">View Migrant Queries</a>
            <a href="/admin/ContactMessages" class="cta-button">View Contact Messages</a>

        <!-- ========================= -->
        <!-- LIA DASHBOARD -->
        <!-- ========================= -->
        <% } else if (session.role === 'lia') { %>

            <p>
                You are logged in as a <strong>Licensed Immigration Adviser</strong>.
                Below is a list of your submitted information.
            </p>

            <a href="/liaSubmit" class="cta-button">Submit New LIA Information</a>

            <h3 style="margin-top: 20px;">Your Submissions</h3>

            <% if (!submissions || submissions.length === 0) { %>
                <p><em>You have not submitted any information yet.</em></p>
            <% } else { %>
                <% submissions.forEach(item => { %>
                    <div class="submission-card">
                        <h4><%= item.title %></h4>
                        <p><%= item.content %></p>

                        <p>
                            <strong>Status:</strong>
                            <span class="status"><%= item.status %></span>
                        </p>

                        <% if (item.status === 'pending') { %>
                            <div class="submission-actions">
                                <a href="/liaEdit/<%= item.id %>" class="btn-secondary">✏️ Edit</a>

                                <form action="/liaDelete/<%= item.id %>" method="POST" style="display:inline;">
                                    <button
                                        type="submit"
                                        class="btn-danger"
                                        onclick="return confirm('Are you sure you want to delete this submission?')"
                                    >
                                        🗑 Delete
                                    </button>
                                </form>
                            </div>
                        <% } else { %>
                            <p><em>This submission can no longer be edited.</em></p>
                        <% } %>
                    </div>
                <% }) %>
            <% } %>

        <!-- ========================= -->
        <!-- MIGRANT DASHBOARD -->
        <!-- ========================= -->
        <% } else { %>

            <p>
                You are logged in as a <strong>Migrant User</strong>.
                You may explore visa information and submit questions.
            </p>

            <a href="/migrantQueries" class="cta-button">Submit a Migration Question</a>
            <a href="/migrant/myqueries" class="cta-button">My Queries & Replies</a>

        <% } %>
    </div>


</body>
</html>
